// filmDB data model — see ../PLAN.md for background.
//
// SQLite (no native enums), so category fields are strings constrained by the
// constants in src/lib/constants.ts:
//   Version.format:        BLURAY | DVD | HD | SD | UNKNOWN
//   Version.videoRange:    SDR | HDR10 | HLG | DOLBY_VISION
//   Film.matchConfidence:  EXACT | SEARCH | LOW | UNMATCHED
//   Album.kind:            STUDIO | COMPILATION | EP | LIVE | SINGLE | REMIX | SOUNDTRACK | OTHER
//   Album.coverSource:     embedded | caa | itunes | manual
//   Track.codec:           alac | aac | mp3 | flac | drm | unknown
//   FilmPhysicalCopy.medium: DVD | BLURAY | UHD
//   ScanRun.kind:          SCAN | ENRICH | JELLYFIN | ENRICH_MUSIC   ScanRun.status: RUNNING | DONE | FAILED

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A TMDB collection (James Bond, Alien, …). Films order by releaseDate for the
// timeline view; owned=false member Films are the "missing" entries.

model Collection {
  id           Int     @id // TMDB collection id
  name         String
  overview     String?
  posterPath   String?
  backdropPath String?
  films        Film[]
}

// One movie identity. Rows also exist for films we DON'T own (owned=false),
// created from TMDB collection membership — that's what the missing-films
// report is built from.

model Film {
  id              Int                @id @default(autoincrement())
  title           String
  sortTitle       String // normalised for sorting/grouping ("Matrix, The" style not needed — just lowercased, articles stripped)
  year            Int?
  imdbId          String?            @unique
  tmdbId          Int?               @unique
  overview        String?
  posterPath      String? // TMDB path; cached locally under /api/poster
  backdropPath    String?
  releaseDate     DateTime?
  runtimeMins     Int?
  rating          Float? // TMDB vote_average
  genres          String? // comma-separated
  owned           Boolean            @default(true)
  matchConfidence String             @default("UNMATCHED")
  collectionId    Int?
  collection      Collection?        @relation(fields: [collectionId], references: [id])
  versions        Version[]
  physicalCopies  FilmPhysicalCopy[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([collectionId])
  @@index([sortTitle])
}

// A physical disc you own of this film — independent of digital ownership
// (Film.owned/versions). Presence of a row means "own on <medium>", full
// stop; the film may or may not also have a ripped Version. Mirrors
// PhysicalCopy below, one row per (film, medium).

model FilmPhysicalCopy {
  id      Int      @id @default(autoincrement())
  filmId  Int
  film    Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  medium  String // DVD | BLURAY | UHD (see Version.format vocabulary)
  barcode String?
  notes   String?
  addedAt DateTime @default(now())

  @@unique([filmId, medium])
  @@index([filmId])
  @@index([barcode])
}

// One file on disk. A film with a DVD rip and a BluRay rip (or theatrical +
// director's cut) has multiple Versions.

model Version {
  id           Int          @id @default(autoincrement())
  filmId       Int
  film         Film         @relation(fields: [filmId], references: [id], onDelete: Cascade)
  filePath     String       @unique // relative to MOVIES_PATH
  fileName     String
  edition      String? // "Theatrical Release", "2003 Directors Cut", "Extended Edition"…
  format       String       @default("UNKNOWN")
  width        Int?
  height       Int?
  videoCodec   String?
  videoRange   String? // SDR | HDR10 | HLG | DOLBY_VISION — null until probed
  container    String? // mkv, mp4…
  sizeBytes    BigInt?
  durationSecs Float?
  mtimeMs      Float? // probe cache key: re-probe only if mtime or size changed
  probedAt     DateTime?
  jellyfinId   String? // Jellyfin library item id (32-hex); set by the Jellyfin sync job
  audioTracks  AudioTrack[]

  @@index([filmId])
}

model AudioTrack {
  id        Int     @id @default(autoincrement())
  versionId Int
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  streamIdx Int
  codec     String?
  profile   String? // e.g. "DTS-HD MA", "DTS", "DD+" — from ffprobe stream profile
  language  String?
  channels  Int?
  layout    String? // "5.1", "stereo"…
  title     String? // "Surround 5.1", "Director's Commentary"…

  @@index([versionId])
}

// --- TV ---
// Same philosophy as movies: rows exist for content we DON'T own
// (Episode.owned=false, created from TMDB season manifests) so the report
// can show missing seasons/episodes per show.

model Show {
  id              Int          @id @default(autoincrement())
  title           String
  sortTitle       String
  year            Int? // first-air year, filename-derived or TMDB
  folder          String       @unique // top-level folder under TVSHOWS_PATH
  tmdbId          Int?         @unique
  imdbId          String?      @unique
  overview        String?
  posterPath      String?
  backdropPath    String?
  firstAirDate    DateTime?
  status          String? // "Ended", "Returning Series", …
  rating          Float?
  genres          String?
  matchConfidence String       @default("UNMATCHED")
  seasons         ShowSeason[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([sortTitle])
}

model ShowSeason {
  id           Int       @id @default(autoincrement())
  showId       Int
  show         Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  seasonNumber Int
  name         String?
  overview     String?
  posterPath   String?
  airDate      DateTime?
  episodes     Episode[]

  @@unique([showId, seasonNumber])
}

model Episode {
  id            Int           @id @default(autoincrement())
  seasonId      Int
  season        ShowSeason    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber Int
  name          String?
  overview      String?
  stillPath     String?
  airDate       DateTime?
  runtimeMins   Int?
  owned         Boolean       @default(false)
  files         EpisodeFile[]

  @@unique([seasonId, episodeNumber])
}

// One file on disk; a multi-episode file (S01E01-E02) links to each Episode
// it covers via its own row per episode sharing the same filePath — so
// filePath is NOT unique here, (filePath, episodeId) is.

model EpisodeFile {
  id           Int       @id @default(autoincrement())
  episodeId    Int
  episode      Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  filePath     String // relative to TVSHOWS_PATH
  fileName     String
  format       String    @default("UNKNOWN")
  width        Int?
  height       Int?
  videoCodec   String?
  videoRange   String?
  container    String?
  sizeBytes    BigInt?
  durationSecs Float?
  audioSummary String? // e.g. "DTS-HD MA 5.1 ENG; AC3 2.0 ENG"
  mtimeMs      Float?
  probedAt     DateTime?
  jellyfinId   String?

  @@unique([filePath, episodeId])
  @@index([episodeId])
}

// Bookkeeping for scans and enrichment runs; log holds a JSON array of
// human-readable notes (unparsed files, low-confidence matches, errors).

model ScanRun {
  id         Int       @id @default(autoincrement())
  kind       String // SCAN | ENRICH | JELLYFIN | ENRICH_MUSIC
  status     String    @default("RUNNING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  filesSeen  Int       @default(0)
  progress   Int       @default(0)
  total      Int       @default(0)
  message    String?
  log        String? // JSON array of strings
}

// A barcode scanned via the /scan batch mode but not yet resolved to an
// added Film/Album — a persistent, cross-device worklist (deliberately NOT
// per-browser localStorage, so a phone scanning session is visible from any
// device). A row is deleted once its barcode is successfully added to the
// collection; it stays here while pending, unresolved ("unknown"), or
// wrong, so the user can retry or correct it later. See
// src/app/api/scan-queue for the CRUD + processing.

model ScanQueueItem {
  id           Int      @id @default(autoincrement())
  barcode      String   @unique
  mediaType    String   @default("auto") // auto | film | album
  status       String   @default("pending") // pending | looking_up | resolved | error
  resultJson   String? // serialized LookupResult, set once status=resolved
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// --- Music ---
// Same philosophy as movies/TV: Album rows exist for back-catalogue entries
// we DON'T own (owned=false), created from MusicBrainz release-group listings.

model Artist {
  id              Int      @id @default(autoincrement())
  name            String
  sortName        String
  folder          String?  @unique // top-level folder under MUSIC_PATH; null for vinyl-only artists with no digital rips
  mbid            String?  @unique // MusicBrainz artist id
  disambiguation  String?
  various         Boolean  @default(false) // Compilations pseudo-artist
  matchConfidence String   @default("UNMATCHED") // EXACT | SEARCH | LOW | UNMATCHED
  studioTotal     Int? // count of official STUDIO release groups MusicBrainz lists, recorded even when gap tracking is off and no placeholders are created
  albums          Album[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sortName])
}

model Album {
  id             Int            @id @default(autoincrement())
  artistId       Int
  artist         Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title          String
  sortTitle      String
  year           Int?
  releaseDate    DateTime?
  mbid           String?        @unique // MusicBrainz release-group id
  kind           String         @default("STUDIO") // STUDIO | COMPILATION | EP | LIVE | SINGLE | REMIX | SOUNDTRACK | OTHER
  coverPath      String? // cached cover art file name under the cover cache dir
  coverSource    String? // embedded | caa | itunes | manual — provenance of coverPath; "manual" is never overwritten
  owned          Boolean        @default(true)
  folder         String? // album folder name under the artist folder (null when owned=false)
  digitalSource  String? // provenance of the digital files: cd | itunes | download | vinyl-code (bundled with the LP); null = unconfirmed
  trackTotal     Int? // canonical track count from MusicBrainz, if known
  tracks         Track[]
  physicalCopies PhysicalCopy[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([artistId, folder])
  @@index([artistId])
}

// A physical copy you own of this album — independent of digital ownership
// (Album.owned). Presence of a row means "own on <medium>", full stop; the
// album may or may not also have digital Tracks. One row per (album, medium):
// owning two different pressings of the same release is an edge case handled
// with a note, not a second row.

model PhysicalCopy {
  id        Int      @id @default(autoincrement())
  albumId   Int
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  medium    String // CD | VINYL (extensible: CASSETTE, SACD, ...)
  format    String // per-medium: LP | 2xLP | 7" | BOX... / CD | 2xCD...
  inferred  Boolean  @default(false) // true for backfilled CD rows not yet confirmed by hand
  discs     Int? // explicit disc count when the format string doesn't say (BOX sets)
  catalogNo String?
  label     String? // pressing label/imprint, can differ from the original
  pressYear Int? // pressing year — often later than Album.year for reissues
  condition String? // free text ("VG+", "Sealed", ...)
  notes     String?
  barcode   String?
  addedAt   DateTime @default(now())

  @@unique([albumId, medium])
  @@index([barcode])
}

model Track {
  id           Int       @id @default(autoincrement())
  albumId      Int
  album        Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  disc         Int       @default(1)
  trackNumber  Int?
  title        String
  filePath     String    @unique // relative to MUSIC_PATH
  fileName     String
  codec        String? // alac | aac | mp3 | flac | drm | unknown
  lossless     Boolean   @default(false)
  sampleRate   Int?
  bitDepth     Int?
  durationSecs Float?
  sizeBytes    BigInt?
  tagYear      Int? // year from the file's own date tag — Album.year fallback when MusicBrainz has no match
  mtimeMs      Float? // probe cache key, same convention as Version
  probedAt     DateTime?

  @@index([albumId])
}

// --- Auth (BetterAuth) ---
// Generated by `npx @better-auth/cli generate` against src/lib/auth.ts.
// User/Session/Account/Verification are the core models (Phase 1); the
// organization plugin (Phase 3) added Household/Member/Invitation and
// Session.activeHouseholdId, remapped from the plugin's generic
// organization/member/invitation naming to match this app's own domain
// language (see HOUSEHOLDS_PLAN.md). @@map keeps BetterAuth's own table-name
// convention rather than this schema's model names leaking into the
// physical tables.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  members     Member[]
  invitations Invitation[]

  // Runs the app (sees /admin, mints access codes, reads the audit log).
  // Deliberately separate from Member.role's "owner"/"member" — that's
  // per-household, this is app-wide and normally true for exactly one user.
  // See src/lib/require-member.ts.
  isAppOwner Boolean @default(false)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeHouseholdId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Access codes — the growth/trust gate for brand-new households (see
// HOUSEHOLDS_PLAN.md "Access codes & the web of trust"). Ported from
// jinglejotter.com's AccessCode model, simplified: this app has no
// monetization, so the `kind`/`accessExpiresAt` trial-vs-lifetime pair is
// dropped entirely. Minted by scripts/gen-access-code.ts, redeemed inside
// Phase 4's createHousehold action via src/lib/access.ts's claimAccessCode.

model AccessCode {
  id              String    @id @default(cuid())
  code            String    @unique // canonical form: MV + 8 chars, no 0/O/1/I/L
  email           String? // null = claimable by anyone signed in; set = bound to one address
  note            String? // admin-only: who/what this code was minted for
  // When the invite email carrying this code was last sent (admin page's
  // "send"/"resend"). Null = minted but never emailed.
  sentAt          DateTime?
  maxRedemptions  Int       @default(1)
  redeemedCount   Int       @default(0)
  redeemableUntil DateTime?
  createdAt       DateTime  @default(now())
}

// Who-did-what metadata for the admin page — deliberately CONTENT-FREE:
// action names and ids only, never titles/names/amounts, so the app owner
// can see how households use the app without seeing what's actually stored
// in it. No FK relations: audit rows must survive their user/household being
// deleted (the admin page renders "(deleted)" instead).
model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String?
  householdId String?
  action      String // "<entity>.<verb>", e.g. "household.create"
  entityId    String?

  @@index([createdAt])
}

model Household {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("Household")
}

model Member {
  id          String    @id
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  createdAt   DateTime

  @@index([householdId])
  @@index([userId])
  @@map("Member")
}

model Invitation {
  id          String    @id
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  email       String
  role        String?
  status      String    @default("pending")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inviterId   String
  user        User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([email])
  @@map("Invitation")
}
