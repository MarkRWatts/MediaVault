# Copy to .env for local dev. See docker-compose.yml for the deployed settings.
DATABASE_URL="file:./data/mediavault.db"
# Root of the movie share (read-only is fine).
MOVIES_PATH="/Volumes/media/Movies"
# Root of the TV share (read-only is fine). Optional — leave unset to skip
# the TV scan/enrich/Jellyfin-TV-match phases entirely.
TVSHOWS_PATH="/Volumes/media/TV Shows"
# Root of the Music share (read-only is fine). Optional — leave unset to skip
# the music scan/enrich phases entirely.
MUSIC_PATH="/Volumes/media/Music"
# Root of the Adult share (read-only is fine). Optional — leave unset to skip
# the Adult scan/enrich phases entirely.
ADULT_PATH="/Volumes/media/Adult"
# Where enrichment caches downloaded posters/backdrops.
POSTER_CACHE_DIR="./data/posters"
# Where Adult enrichment caches downloaded artwork.
ADULT_IMAGE_CACHE_DIR="./data/adult-images"
# Where in-app video playback caches remuxed/transcoded files (see
# src/lib/video-cache.ts) — populated on first play of a file that isn't
# already a direct-playable MP4, then reused for every later play/seek.
VIDEO_CACHE_DIR="./data/video-cache"
# Cap on that cache's total size in bytes -- oldest-played files are deleted
# first once it's exceeded. Defaults to 10 GiB if unset.
VIDEO_CACHE_MAX_BYTES="10737418240"
# If ffprobe is not on PATH, the scanner runs it via `docker run` with this
# image (the movies dir is bind-mounted read-only). Leave unset when ffprobe
# is installed (the Docker image installs it).
FFPROBE_DOCKER_IMAGE="mwader/static-ffmpeg:latest"
# TMDB API key (free) — enables posters, metadata, and collection/missing-film
# detection. https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
# ThePornDB API key (free) — enables Adult metadata/artwork enrichment.
# https://theporndb.net (Account -> API Tokens)
THEPORNDB_API_KEY=""
# Optional: point MusicBrainz lookups at a self-hosted mirror (see
# metabrainz/musicbrainz-docker) instead of the public API — e.g.
# "http://localhost:15000/ws/2". Leave unset to use musicbrainz.org.
MUSICBRAINZ_BASE_URL=""
# Optional: Discogs personal access token — raises the API rate limit
# (25/min -> 60/min) for the Discogs fallback used when MusicBrainz has no
# entry for a specific pressing (see src/lib/discogs.ts). Not required at
# this app's scale (occasional manual "link a pressing" lookups).
DISCOGS_TOKEN=""
# Optional: artist bio/photo/backdrop enrichment (see src/lib/artist-bio.ts).
# TheAudioDB needs no signup at this scale (falls back to the shared public
# test key "2" if unset) — set AUDIODB_API_KEY to use a personal one instead.
AUDIODB_API_KEY=""
# Fanart.tv gives better backdrop art specifically, but strictly requires a
# free personal key (https://fanart.tv/get-an-api-key/) — enrichment simply
# skips it and falls back to TheAudioDB/Wikipedia if this is left unset.
FANART_API_KEY=""
# Jellyfin integration (optional): enables "Play in Jellyfin" links and
# post-scan library sync. Create a key under Dashboard -> API Keys.
JELLYFIN_URL=""
JELLYFIN_API_KEY=""
# Folder id (GUID) of the Adult library in Jellyfin's dashboard — required
# for the /account opt-in to grant/revoke that folder in Jellyfin.
ADULT_JELLYFIN_FOLDER_ID=""
# BetterAuth (see HOUSEHOLDS_PLAN.md) — signing/encryption key for sessions
# and cookies. Generate one with `npx @better-auth/cli secret` and keep it
# out of version control; rotating it invalidates all existing sessions.
BETTER_AUTH_SECRET=""
# BetterAuth's own base URL — used to build callback/redirect URLs. Matches
# where the app is actually served from (local dev's port 3002, see
# docker-compose.override.yml).
BETTER_AUTH_URL="http://localhost:3002"
# Resend API key — sends the email-OTP sign-in codes (see HOUSEHOLDS_PLAN.md
# and src/lib/email.ts). Domain-verified for markrwatts.com.
# https://resend.com/api-keys
RESEND_API_KEY=""
# The web of trust's root anchor (see HOUSEHOLDS_PLAN.md "Access codes & the
# web of trust") — comma-separated email(s), case-insensitive. The product
# owner's own address(es); this is the one thing no database state (a
# revoked membership, a cancelled invite, an expired access code) can lock
# out. Everyone else signs in via household membership, a pending
# invitation, or a minted access code (see src/lib/allowed-email.ts).
ALLOWED_EMAILS=""
