# VM deployment env — copy to .env.docker ON THE SERVER (never commit the
# real one) and pass via:
#   docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# Empty placeholder dir for the base compose's bind mount (the real share is
# mounted as a CIFS named volume by docker-compose.prod.yml instead).
MOVIES_HOST_PATH=/home/deploy/MediaVault-empty

# Microserver SMB share holding the Movies folder — use a read-only account.
MOVIES_SMB_HOST=nas.example.lan
MOVIES_SMB_SHARE=media
MOVIES_SMB_USERNAME=
MOVIES_SMB_PASSWORD=

# TMDB (free key) — posters, metadata, collections/missing-film detection.
TMDB_API_KEY=

# Optional: self-hosted MusicBrainz mirror (metabrainz/musicbrainz-docker via
# OrbStack on the Mac) instead of the public API — e.g.
# http://192.168.1.129:15000/ws/2 (Mac's LAN IP; OrbStack exposes container
# ports to the LAN by default). Must be running before a music scan/enrich,
# or lookups fail outright rather than falling back to musicbrainz.org.
MUSICBRAINZ_BASE_URL=

# Root of the TV share (same "media" SMB share, TV Shows subfolder). Optional
# — leave unset to skip the TV scan/enrich/Jellyfin-TV-match phases.
TVSHOWS_PATH=/media-share/TV Shows

# Root of the Music share (same "media" SMB share, Music subfolder). Optional
# — leave unset to skip the music scan/enrich phases.
MUSIC_PATH=/media-share/Music

# Jellyfin integration (optional) — see README.
JELLYFIN_URL=http://nas.example.lan:8096
JELLYFIN_API_KEY=
# Prefix Jellyfin's item paths carry before the relative movie path.
JELLYFIN_MOVIES_PREFIX=/media/Movies/
# Prefix Jellyfin's item paths carry before the relative TV episode path.
JELLYFIN_TV_PREFIX=/media/TV Shows/

# BetterAuth (see HOUSEHOLDS_PLAN.md) — session/cookie signing key. Generate
# with `npx @better-auth/cli secret`; keep the real value out of git.
BETTER_AUTH_SECRET=
# BetterAuth's own base URL — the app's public URL on this VM.
BETTER_AUTH_URL=https://mediavault.markrwatts.com

# Resend API key — sends the email-OTP sign-in codes (see HOUSEHOLDS_PLAN.md
# and src/lib/email.ts). Domain-verified for markrwatts.com.
RESEND_API_KEY=

# The web of trust's root anchor (see HOUSEHOLDS_PLAN.md "Access codes & the
# web of trust") — comma-separated email(s), case-insensitive. The product
# owner's own address(es); this is the one thing no database state can lock
# out. Everyone else signs in via household membership, a pending
# invitation, or a minted access code (see src/lib/allowed-email.ts).
ALLOWED_EMAILS=
