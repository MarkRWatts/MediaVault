# Copy to .env for local dev. See docker-compose.yml for the deployed settings.
DATABASE_URL="file:./data/filmdb.db"
# Root of the movie share (read-only is fine).
MOVIES_PATH="/Volumes/media/Movies"
# Root of the TV share (read-only is fine). Optional — leave unset to skip
# the TV scan/enrich/Jellyfin-TV-match phases entirely.
TVSHOWS_PATH="/Volumes/media/TV Shows"
# Where enrichment caches downloaded posters/backdrops.
POSTER_CACHE_DIR="./data/posters"
# If ffprobe is not on PATH, the scanner runs it via `docker run` with this
# image (the movies dir is bind-mounted read-only). Leave unset when ffprobe
# is installed (the Docker image installs it).
FFPROBE_DOCKER_IMAGE="mwader/static-ffmpeg:latest"
# TMDB API key (free) — enables posters, metadata, and collection/missing-film
# detection. https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
# Jellyfin integration (optional): enables "Play in Jellyfin" links and
# post-scan library sync. Create a key under Dashboard -> API Keys.
JELLYFIN_URL=""
JELLYFIN_API_KEY=""
