# VM deployment env — copy to .env.docker ON THE SERVER (never commit the
# real one) and pass via:
#   docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# Empty placeholder dir for the base compose's bind mount (the real share is
# mounted as a CIFS named volume by docker-compose.prod.yml instead).
MOVIES_HOST_PATH=/home/deploy/filmDB-empty

# Microserver SMB share holding the Movies folder — use a read-only account.
MOVIES_SMB_HOST=nas.example.lan
MOVIES_SMB_SHARE=media
MOVIES_SMB_USERNAME=
MOVIES_SMB_PASSWORD=

# TMDB (free key) — posters, metadata, collections/missing-film detection.
TMDB_API_KEY=

# Root of the TV share (same "media" SMB share, TV Shows subfolder). Optional
# — leave unset to skip the TV scan/enrich/Jellyfin-TV-match phases.
TVSHOWS_PATH=/media-share/TV Shows

# Root of the Music share (same "media" SMB share, Music subfolder). Optional
# — leave unset to skip the music scan/enrich phases.
MUSIC_PATH=/media-share/Music

# Jellyfin integration (optional) — see README.
JELLYFIN_URL=http://nas.example.lan:8096
JELLYFIN_API_KEY=
# Prefix Jellyfin's item paths carry before the relative movie path.
JELLYFIN_MOVIES_PREFIX=/media/Movies/
# Prefix Jellyfin's item paths carry before the relative TV episode path.
JELLYFIN_TV_PREFIX=/media/TV Shows/
